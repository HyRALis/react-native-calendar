# Copy this file to .env, then paste your Firebase web app configuration.
# Firebase Console > Project settings > General > Your apps > Web app.
# Public client identifiers only; never service-account keys or passwords.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
